# =================================================================
# CONFIGURACIÓN DE ENTORNO - Google Forms Automation Backend
# =================================================================

# Entorno de la aplicación
NODE_ENV=development
PORT=3000
API_VERSION=v1

# =================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =================================================================

# MongoDB Configuration
DB_HOST=localhost
DB_PORT=27017
DB_NAME=google_forms_automation
DB_USER=
DB_PASSWORD=
DB_CONNECTION_STRING=mongodb://localhost:27017/google_forms_automation

# Configuración de conexión
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=30000

# =================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Encriptación
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=your-encryption-key-32-characters

# =================================================================
# CONFIGURACIÓN DE RATE LIMITING
# =================================================================

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Rate Limiting por usuario autenticado
RATE_LIMIT_AUTH_WINDOW_MS=3600000
RATE_LIMIT_AUTH_MAX_REQUESTS=1000

# Rate Limiting para uploads
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX_REQUESTS=10

# =================================================================
# CONFIGURACIÓN DE ARCHIVOS Y STORAGE
# =================================================================

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./storage
STORAGE_BASE_URL=http://localhost:3000/files

# AWS S3 Configuration (si se usa)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=google-forms-automation

# Configuración de archivos
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx
FILE_RETENTION_DAYS=365

# =================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO
# =================================================================

# SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=FSO Automation System
EMAIL_FROM_ADDRESS=noreply@fso-automation.com

# =================================================================
# CONFIGURACIÓN DE PUPPETEER
# =================================================================

# Puppeteer Configuration
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000
PUPPETEER_VIEWPORT_WIDTH=1366
PUPPETEER_VIEWPORT_HEIGHT=768

# Google Forms Configuration
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform

# Session Configuration
SESSION_TIMEOUT=3600000
MAX_SESSION_AGE=86400000

# =================================================================
# CONFIGURACIÓN DE LOGS
# =================================================================

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =================================================================
# URLs y CONFIGURACIÓN EXTERNA
# =================================================================

# Base URLs
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002

# =================================================================
# CONFIGURACIÓN DE CORS
# =================================================================

# CORS Settings
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
CORS_CREDENTIALS=true