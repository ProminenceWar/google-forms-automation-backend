{
  "name": "google-forms-automation-backend",
  "version": "1.0.0",
  "description": "Backend API for Google Forms FSO automation with comprehensive data management",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "docs": "jsdoc -c jsdoc.conf.json",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "setup-db": "node scripts/initDatabase.js",
    "insert-sample-data": "node scripts/insertSampleData.js",
    "insert-sample-data:clear": "node scripts/insertSampleData.js --clear",
    "connect-atlas": "node scripts/connectToAtlas.js",
    "verify-atlas": "node scripts/verifyAtlasSetup.js",
    "test-api": "node scripts/testAPIEndpoints.js",
    "playground": "mongosh --file playground-1.mongodb.js",
    "health": "node -e \"const db = require('./src/database/connection'); new db().healthCheck().then(console.log).catch(console.error)\"",
    "logs": "Get-Content logs/app.log -Wait -Tail 50",
    "logs:error": "Get-Content logs/app-error.log -Wait -Tail 50"
  },
  "keywords": [
    "google-forms",
    "fso-automation",
    "api",
    "express",
    "puppeteer",
    "pdf-processing",
    "data-management",
    "telecommunications"
  ],
  "author": "ProminenceWar",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^7.8.7",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.5",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.1",
    "puppeteer": "^21.3.8",
    "sharp": "^0.32.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.10.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "axios": "^1.11.0",
    "eslint": "^8.49.0",
    "eslint-config-node": "^4.1.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
